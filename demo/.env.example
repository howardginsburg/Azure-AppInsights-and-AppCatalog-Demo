# Example only. demo/setup.sh (run by ./deploy.sh) generates the real demo/.env, which is
# gitignored. You don't need to create this file by hand.
#
# One Application Insights connection string per demo app. The variable name is APPINSIGHTS_
# followed by the app name in upper case, with '-' and '.' replaced by '_'. Real environment
# variables override the file.
#
# Format:
#   InstrumentationKey=<guid>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/;LiveEndpoint=https://<region>.livediagnostics.monitor.azure.com/;ApplicationId=<guid>
APPINSIGHTS_RETAIL_WEB=
APPINSIGHTS_RETAIL_API_ORDERS=
APPINSIGHTS_RETAIL_API_CATALOG=
APPINSIGHTS_PAY_API_GATEWAY=
APPINSIGHTS_PAY_WORKER_SETTLEMENT=
APPINSIGHTS_CUST_API_PROFILE=
APPINSIGHTS_CUST_WORKER_NOTIFY=
APPINSIGHTS_SHARED_API_INVENTORY=
