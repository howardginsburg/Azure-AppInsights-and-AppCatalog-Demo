// ---------------------------------------------------------------------------
// End-to-end transaction reconstruction.
//
// Rebuilds a single distributed trace across every service and database it touched,
// ordered by time, with indentation showing call depth. This is the query behind
// "show me exactly what happened on this one checkout".
//
// Set {OperationId} to a specific trace, or leave the default to pick the most
// interesting recent failure automatically.
// ---------------------------------------------------------------------------
let targetOperation =
    toscalar(
        AppRequests
        | where TimeGenerated {TimeRange}
        | where Success == false and AppRoleName == "retail-web"
        | top 1 by TimeGenerated desc
        | project OperationId
    );
union
    (AppRequests
     | where TimeGenerated {TimeRange}
     | where OperationId == targetOperation
     | project TimeGenerated, Service = AppRoleName, Kind = "request", Name,
               DurationMs, Success, Detail = tostring(ResultCode), ParentId, SpanId = Id),
    (AppDependencies
     | where TimeGenerated {TimeRange}
     | where OperationId == targetOperation
     | project TimeGenerated, Service = AppRoleName, Kind = strcat("dep:", DependencyType), Name,
               DurationMs, Success, Detail = Target, ParentId, SpanId = Id)
| order by TimeGenerated asc
| project
    Offset_ms = round(datetime_diff('millisecond', TimeGenerated, toscalar(
        union AppRequests, AppDependencies
        | where OperationId == targetOperation
        | summarize min(TimeGenerated))), 0),
    Service,
    Kind,
    Name,
    DurationMs = round(DurationMs, 1),
    Success,
    Detail
