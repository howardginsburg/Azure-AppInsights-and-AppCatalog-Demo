// ---------------------------------------------------------------------------
// Domain rollup — health aggregated by business domain.
//
// This is the doc 05 taxonomy paying off. The domain is not a deployment boundary
// and not a workspace boundary; it is a *tag* carried on the resource and mirrored
// in the catalog. That means an exec-facing rollup is a one-line `by Domain`.
//
// Note that shared-api-inventory sits in the Platform domain but its failures
// surface in Retail and Payments — which is exactly why blast-radius.kql exists
// as a companion to this view.
// ---------------------------------------------------------------------------
let domainOf = datatable(workload: string, Domain: string, Criticality: string)
[
    "retail-web",           "Retail",   "tier-1",
    "retail-api-orders",    "Retail",   "tier-1",
    "retail-api-catalog",   "Retail",   "tier-2",
    "pay-api-gateway",      "Payments", "tier-1",
    "pay-worker-settlement","Payments", "tier-1",
    "cust-api-profile",     "Customer", "tier-2",
    "cust-worker-notify",   "Customer", "tier-3",
    "shared-api-inventory", "Platform", "tier-1"
];
AppRequests
| where TimeGenerated {TimeRange}
| summarize
    Requests = count(),
    Failures = countif(Success == false),
    P95ms    = percentile(DurationMs, 95)
  by workload = AppRoleName
| join kind=leftouter domainOf on workload
| summarize
    Services       = dcount(workload),
    Requests       = sum(Requests),
    Failures       = sum(Failures),
    WorstP95ms     = round(max(P95ms), 0),
    Tier1Services  = dcountif(workload, Criticality == "tier-1")
  by Domain
| extend
    FailureRatePct = round(100.0 * Failures / Requests, 2),
    AvailabilityPct = round(100.0 * (Requests - Failures) / Requests, 3)
| extend Health = case(
    FailureRatePct >= 5.0, "🔴 Degraded",
    FailureRatePct >= 1.0, "🟠 Warning",
    "🟢 Healthy")
| project Domain, Health, Services, Tier1Services, Requests, Failures,
          FailureRatePct, AvailabilityPct, WorstP95ms
| order by FailureRatePct desc
