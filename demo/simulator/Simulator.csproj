<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ObsDemo.Simulator</RootNamespace>
    <AssemblyName>obsdemo-simulator</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.10.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.14" />
    <PackageReference Include="OpenTelemetry" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exporter 1.9+ saves telemetry still queued at shutdown and uploads it on a later run.
         The simulator often runs once, so it delivers everything before exiting instead. -->
    <RuntimeHostConfigurationOption Include="Azure.Monitor.OpenTelemetry.Exporter.DisablePersistOnShutdown" Value="true" />
  </ItemGroup>

</Project>
