# Local development settings. In Azure these are App Service application settings, set by
# infra/main.bicep. Copy to .env and fill in values from your deployment:
#   az deployment group show -g <rg> -n platform --query properties.outputs

# Log Analytics workspace ID (the GUID "customerId"), used for queries.
LA_WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# Log Analytics workspace resource ID, used to find the Application Insights resources linked
# to it and read their tags.
LA_WORKSPACE_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<rg>/providers/Microsoft.OperationalInsights/workspaces/<workspace>

# Azure SQL catalog (Microsoft Entra authentication; no username or password).
SQL_SERVER=<sql-server>.database.windows.net
SQL_DATABASE=catalogdb

# Optional sovereign-cloud endpoints.
# LA_API_HOST=https://api.loganalytics.io
# ARM_HOST=https://management.azure.com

# Port for the local Express API. The Vite dev server proxies /api here.
PORT=8080
