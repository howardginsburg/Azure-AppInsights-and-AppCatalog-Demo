# ---------------------------------------------------------------------------
# Secrets and local environment
# ---------------------------------------------------------------------------
# deploy.sh writes .env with Application Insights connection strings, which
# contain instrumentation keys, plus the subscription id. It is regenerated on
# every deploy, so there is never a reason to commit it.
.env
.env.*
!.env.example

*.pem
*.key
*.pfx
*.publishsettings

# Azure CLI / azd local state
.azure/

# ---------------------------------------------------------------------------
# .NET build output (simulator)
# ---------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
*.user
*.suo
*.userprefs
project.lock.json
artifacts/

# ---------------------------------------------------------------------------
# Node
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
.npm/

# ---------------------------------------------------------------------------
# Editors and IDEs
# ---------------------------------------------------------------------------
.vs/
.vscode/
.idea/
*.swp

# ---------------------------------------------------------------------------
# OS and Office cruft
# ---------------------------------------------------------------------------
# ~$... are Office lock files, which appear whenever the deck is open in
# PowerPoint and are never meant to be shared.
~$*
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ---------------------------------------------------------------------------
# Scratch
# ---------------------------------------------------------------------------
*.bak
*.tmp
*.log
slide-*.jpg
slide-*.png
*.pdf

# ---------------------------------------------------------------------------
# Customer-facing deck
# ---------------------------------------------------------------------------
# The deck and its generator are kept out of source control deliberately: the
# .pptx is a large binary that diffs badly, and the deck is a customer-facing
# artifact with its own review cycle rather than a build output of this repo.
deck/

# ---------------------------------------------------------------------------
# Deliberately NOT ignored
# ---------------------------------------------------------------------------
# demo/workbook-portfolio.json is generated by build-workbook.mjs, but it is
# committed on purpose: deploy.sh falls back to it when node is unavailable,
# and the build is reproducible (see .gitattributes — the sources are stored
# LF, so a fresh clone rebuilds a byte-identical file).
